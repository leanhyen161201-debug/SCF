{
  "name": "scf-monorepo",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:server": "pnpm --filter @scf/server dev",
    "dev:web": "pnpm --filter @scf/web dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:migrate": "pnpm --filter @scf/server prisma migrate dev",
    "db:seed": "pnpm --filter @scf/server prisma db seed",
    "db:studio": "pnpm --filter @scf/server prisma studio",
    "test:e2e": "turbo run test:e2e",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.16.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "turbo": "^2.1.0",
    "typescript": "^5.5.0"
  },
  "packageManager": "pnpm@9.1.0"
}
